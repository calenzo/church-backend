# ===== Aplicação =====
# Desenvolvimento local (sem Docker): SQLite
DATABASE_URL=sqlite:///./church.db
# Docker: definido no docker-compose.yml (Postgres), não precisa editar aqui.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/church
CORS_ORIGINS=*

# Docker: o compose sobrescreve para http://evolution:8080
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=church
# Opcional: valida o webhook (configure o mesmo valor na Evolution)
WEBHOOK_TOKEN=
